			"Adjectives",
			"Verbs",
			"Nouns",
		},
	},
})

--
local QuestionData = {}

function QuestionData:GetData()
	return Data
end

function QuestionData:GetTwoRandomWrongAnswersFromQuestion(question: table)
	local wrongAnswers: { string } = question.WrongAnswers

	if #wrongAnswers < 2 then
		error("Not enough wrong answers to select from!")
		return
	end

	local selectedAnswers: { string } = {}

	local options: { number } = { 1, 2, 3 }
	table.remove(options, math.random(1, #options)) -- Remove one option so we have two wrong answers

	for _, index in ipairs(options) do
		table.insert(selectedAnswers, wrongAnswers[index])
	end

	return selectedAnswers
end

return QuestionData
